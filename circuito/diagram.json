{
  "version": 1,
  "author": "Renan Paulino",
  "editor": "wokwi",
  "parts": [
    {
      "type": "board-esp32-s3-devkitc-1",
      "id": "esp",
      "top": 0,
      "left": 0,
      "attrs": {}
    },
    {
      "type": "wokwi-membrane-keypad",
      "id": "keypad1",
      "top": -160,
      "left": 260,
      "attrs": {}
    },
    {
      "type": "board-ssd1306",
      "id": "oled1",
      "top": -160,
      "left": -220,
      "attrs": { "i2cAddress": "0x3c" }
    },
    {
      "type": "wokwi-buzzer",
      "id": "bz1",
      "top": 140,
      "left": -140,
      "attrs": { "volume": "0.1" }
    },
    {
      "type": "wokwi-led",
      "id": "led1",
      "top": 170,
      "left": 60,
      "attrs": { "color": "limegreen" }
    },
    {
      "type": "wokwi-resistor",
      "id": "r1",
      "top": 170,
      "left": 10,
      "rotate": 90,
      "attrs": { "value": "220" }
    }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],

    [ "esp:8", "oled1:SDA", "green", [] ],
    [ "esp:9", "oled1:SCL", "yellow", [] ],
    [ "oled1:VCC", "esp:5V", "red", [] ],
    [ "oled1:GND", "esp:GND.1", "black", [] ],

    [ "esp:7", "bz1:2", "green", [] ],
    [ "bz1:1", "esp:GND.2", "black", [] ],

    [ "esp:15", "r1:1", "green", [] ],
    [ "r1:2", "led1:A", "green", [] ],
    [ "led1:C", "esp:GND.3", "black", [] ],

    [ "keypad1:R1", "esp:4", "blue", [] ],
    [ "keypad1:R2", "esp:5", "blue", [] ],
    [ "keypad1:R3", "esp:6", "blue", [] ],
    [ "keypad1:R4", "esp:16", "blue", [] ],
    [ "keypad1:C1", "esp:17", "orange", [] ],
    [ "keypad1:C2", "esp:18", "orange", [] ],
    [ "keypad1:C3", "esp:21", "orange", [] ],
    [ "keypad1:C4", "esp:35", "orange", [] ]
  ],
  "dependencies": {}
}
