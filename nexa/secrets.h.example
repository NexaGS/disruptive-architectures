// O "secrets.h" real NAO deve ser commitado (ver .gitignore na raiz do repo).

// Configurações de Rede
#define SECRET_WIFI_SSID "COLOQUE_SUA_REDE_WIFI_AQUI"
#define SECRET_WIFI_PASSWORD "COLOQUE_SUA_SENHA_AQUI"
